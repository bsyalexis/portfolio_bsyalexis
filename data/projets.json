  {
    "slug": "eva-challenger-league",
    "title": "EVA CHALLENGER LEAGUE - OFFICIAL TRAILER",
    "client": "EVA",
    "category": "video",
    "year": "2026",
    "cover": "/images/projets/eva-cl/3.webp",
